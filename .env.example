# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values you have. Everything here is
# optional in the sense that the app will boot without it, but a given
# platform/provider will simply be unavailable until its keys are set.
# ---------------------------------------------------------------------------

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-string
# Leave empty for no login (localhost only). Set a strong password before exposing the app.
APP_PASSWORD=
DATABASE_URL=sqlite:///./data/app.db
MEDIA_DIR=./media
TIMEZONE=Africa/Cairo

# --- LLM providers (idea + text generation) ---
# Gemini has a generous free tier: https://ai.google.dev/
GEMINI_API_KEY=
# Model names retire over time — check https://ai.google.dev/gemini-api/docs/deprecations
# and confirm your key still has free-tier quota for this model; otherwise use LLM_PROVIDER=ollama.
GEMINI_MODEL=gemini-3.5-flash-lite
# If you'd rather run a fully local/free model via Ollama (https://ollama.com)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Which provider idea_generator.py should default to: "gemini" or "ollama"
LLM_PROVIDER=gemini

# --- Trend detection ---
# pytrends needs no API key (it scrapes the public Google Trends UI).
# YouTube Data API v3 key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# --- Image generation ---
# Pollinations.ai needs no key for basic use: https://pollinations.ai/
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt

# --- Video captions ---
# ImageMagick font name with Arabic glyphs (list with: convert -list font | grep Font:)
CAPTION_FONT=DejaVu-Sans

# --- Royalty-free music ---
JAMENDO_CLIENT_ID=

# --- YouTube publishing (OAuth2, not the API key above) ---
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json

# --- Instagram / Facebook Graph API ---
META_PAGE_ID=
META_IG_BUSINESS_ACCOUNT_ID=
META_PAGE_ACCESS_TOKEN=
# Graph API needs a public URL for the media file (it won't accept raw
# uploads). Point this at your own domain or a tunnel (ngrok/Cloudflare
# Tunnel) serving the ./media directory. No trailing slash.
MEDIA_PUBLIC_BASE_URL=

# --- TikTok Content Posting API ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# --- Twitter / X API (free tier) ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
